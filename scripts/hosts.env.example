# RPi の接続先。実ファイル scripts/hosts.env は .gitignore 対象（公開しない）。
#   cp scripts/hosts.env.example scripts/hosts.env  して自分の環境の値を入れる。
#
# SSH_HOSTS は rover/exp_backends.py がそのまま読む（上から順に試す）。
# 家Wi-Fi → DHCP で変動するので繋がらなければポート22走査で現IPを探す。
# RPi 自身のホットスポットは 192.168.4.1 固定。
SSH_HOSTS=192.168.0.32,192.168.0.31,192.168.4.1

# RPi 側のログインユーザ（車体を入れ替えたら変わり得る）
RPI_USER=mukougawakouhei

# 大学ネットワーク経由で入る場合のホスト。
# グローバルIPなので公開リポジトリには書かない。hosts.env にだけ書く。
UNIV_HOST=
