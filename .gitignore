# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# WSL/Windows のメタデータ
*:Zone.Identifier

# 大容量の作業用動画（docs/tags は193MB規模）
*.mp4

# 生成物（docs/build_thesis_html.py で再生成できる）
docs/thesis/thesis.html

# 他者の著作物（参考論文PDF）。リポジトリに入れない。
data/paper/

# 実機実験の生データ。未発表のため公開しない。
results/

# 院試・発表資料、実験中の写真
# ("*:Zone.Identifier" は12行目に既存パターンがあるため重複追記しない)
*.pdf
*.jpg

# 研究会の卒論概要（docs/abstract/）
# 本体リポジトリは PUBLIC。先輩の概要（氏名・学籍番号・研究室写真を含む）と
# JSME配布の書式ファイルは追跡しない。自分の .tex と図のみを追跡する。
docs/abstract/*.cls
docs/abstract/*.sty
docs/abstract/abstract.*
docs/abstract/missfont.log
# サンプルに付属する図のみ除外（自分の図は追跡する）
docs/abstract/fig/Turtlebot3.jpg
docs/abstract/fig/e2-comparison.png
# LaTeX ビルド成果物
docs/abstract/*.aux
docs/abstract/*.log
docs/abstract/*.dvi
docs/abstract/*.bbl
docs/abstract/*.blg
docs/abstract/*.out
